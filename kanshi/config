# ~/.config/kanshi/config — Dynamic Display Topology Profiles

profile undocked {
    output "eDP-1" mode 1920x1080@144Hz position 0,0
}

profile docked_hdmi1 {
    output "eDP-1" mode 1920x1080@144Hz position 0,0
    output "HDMI-A-1" mode 1920x1080@144Hz position 1920,0
}

profile docked_hdmi2 {
    output "eDP-1" mode 1920x1080@144Hz position 0,0
    output "HDMI-A-2" mode 1920x1080@144Hz position 1920,0
}

profile docked_dp1 {
    output "eDP-1" mode 1920x1080@144Hz position 0,0
    output "DP-1" mode 1920x1080@144Hz position 1920,0
}
