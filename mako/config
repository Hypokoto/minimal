# Minimal Mako Config — Bento Pill Notifications & OSD
# Generated from palette.md — DO NOT edit directly.
# Requires mako >= 1.7 for progress-bar 'value' hint rendering

font=AdwaitaMono Nerd Font 10
background-color=#0A0A0A
text-color=#F2F6FF
border-color=#141414
border-size=1
border-radius=10
padding=14 16
margin=10
width=320
height=110
default-timeout=4000
progress-color=source #00D9FF

[urgency=low]
border-color=#141414

[urgency=normal]
border-color=#141414

[urgency=critical]
border-color=#FF5470
default-timeout=0

# OSD notifications (volume: 91110 / brightness: 91111) — replace in place, zero latency
[app-name="minimal-osd"]
group-by=category
default-timeout=1500
border-color=#141414
progress-color=source #00D9FF
