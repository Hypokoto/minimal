# Minimal mako config
# Generated from palette.md — DO NOT edit directly.
# Requires mako >= 1.7 for progress-bar 'value' hint rendering

font=AdwaitaMono Nerd Font 10
background-color=#11141D
text-color=#F2F6FF
border-color=#1C2230
border-size=1
border-radius=12
padding=16
margin=8
width=320
height=100
default-timeout=4000
progress-color=source #00D9FF

[urgency=low]
border-color=#1C2230

[urgency=normal]
border-color=#1C2230

[urgency=critical]
border-color=#FF5470
default-timeout=0

# OSD notifications (volume/brightness) — replace in place, no stacking
[app-name="minimal-osd"]
group-by=category
default-timeout=1500
border-color=#1C2230
progress-color=source #00D9FF
