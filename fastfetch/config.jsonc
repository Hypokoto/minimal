// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 2,
      "right": 2
    },
    "color": { "1": "#7DD3FC", "2": "#8BA4FF" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#7DD3FC", "title": "#E8EDF5" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "detectURL": false
    },
    "cpu",
    {
      "type": "gpu",
      "key": "GPU",
      "hideType": "integrated"
    },
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
