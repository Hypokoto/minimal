@import "theme.rasi"

window {
    width: 340px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: @bg;
    padding: 14px;
    children: [ listview ];
}

listview {
    columns:      1;
    lines:        3;
    spacing:      6px;
    fixed-height: true;
    background-color: transparent;
}

element {
    padding:        10px 12px;
    border-radius:  8px;
    background-color: @surface;
}

element-text {
    text-color: inherit;
}

/* index 0 = Performance -> highlight, 1 = Balanced -> info, 2 = Power Saver -> muted (default) */
element.normal           { text-color: @muted; }
element.normal.urgent    { text-color: @highlight; }
element.normal.active    { text-color: @info; }

element.selected.normal { background-color: @overlay; border: 0px 0px 0px 2px; border-color: @primary; }
element.selected.urgent { background-color: @overlay; border: 0px 0px 0px 2px; border-color: @highlight; text-color: @highlight; }
element.selected.active { background-color: @overlay; border: 0px 0px 0px 2px; border-color: @info; text-color: @info; }
