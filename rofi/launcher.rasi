@import "theme.rasi"

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "LAUNCH";
    drun-display-format: "{name} [<span size='9pt' fgcolor='#8D95B3'>{generic}</span>]";
    drun-match-fields: "name,generic,exec,categories";
}

window {
    width: 720px;
    location: center;
    anchor: center;
    border-radius: 14px;
    border: 1px;
    border-color: @overlay;
    background-color: @bg;
}

mainbox {
    orientation: horizontal;
    children: [ leftbox, rightbox ];
    spacing: 0px;
    background-color: transparent;
}

leftbox {
    orientation: vertical;
    expand: false;
    width: 180px;
    background-color: @surface-trans;
    border: 0px 1px 0px 0px;
    border-color: @overlay;
    children: [ mode-switcher, dummy ];
}

dummy {
    expand: true;
    background-color: transparent;
}

mode-switcher {
    orientation: vertical;
    spacing: 0px;
    padding: 12px 0px;
    background-color: transparent;
    border: 0px;
    expand: false;
}

button {
    padding: 10px 16px;
    border-radius: 0px;
    text-color: @muted;
    background-color: transparent;
    cursor: pointer;
    font: "Adwaita Sans 10";
    border: 0px;
    horizontal-align: 0.0;
}

button selected {
    text-color: @primary;
    background-color: @surface;
    border: 0px 0px 0px 3px;
    border-color: @primary;
}

rightbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    expand: true;
    padding: 16px;
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg;
    border-radius: 4px;
    border: 1px;
    border-color: @overlay;
    padding: 12px;
}

prompt {
    text-color: @primary;
    font: "Adwaita Sans 11 Bold";
    padding: 0px 12px 0px 0px;
    background-color: inherit;
}

entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @muted;
    font: "Adwaita Sans 13";
    background-color: inherit;
}

listview {
    columns: 1;
    lines: 10;
    spacing: 6px;
    fixed-height: false;
    markup-rows: true;
    background-color: transparent;
    border: 0px;
}

element {
    orientation: horizontal;
    padding: 8px 12px;
    border-radius: 4px;
    background-color: transparent;
    border: 0px;
}

element selected {
    background-color: @overlay;
    text-color: @fg;
    border-color: @primary;
}

element normal {
    text-color: @fg;
}

element-icon {
    size: 32px;
    margin: 0px 14px 0px 0px;
    background-color: inherit;
}

element-text {
    text-color: inherit;
    background-color: inherit;
    vertical-align: 0.5;
    font: "Adwaita Sans 10";
}
