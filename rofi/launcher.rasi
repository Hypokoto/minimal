@import "theme.rasi"

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Launch";
    drun-display-format: "{name}  [<span size='9pt' fgcolor='#8D95B3'>{generic}</span>]";
    drun-match-fields: "name,generic,exec,categories";
}

window {
    width: 25%;
    height: 100%;
    location: north west;
    anchor: north west;
    y-offset: 0px;
    x-offset: 0px;
    border-radius: 0px;
}

mainbox {
    orientation: horizontal;
    children: [ mode-switcher, rightbox ];
    spacing: 0px;
}

mode-switcher {
    orientation: vertical;
    width: 160px;
    spacing: 6px;
    padding: 20px 10px;
    background-color: @surface-trans;
}

button {
    padding: 10px 14px;
    border-radius: 8px;
    text-color: @muted;
    background-color: transparent;
    cursor: pointer;
}

button selected {
    text-color: @primary;
    background-color: @overlay;
}

rightbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    expand: true;
    padding: 20px 24px;
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @overlay;
    border-radius: 8px;
    padding: 10px 14px;
}

prompt {
    text-color:  @primary;
    font:        "AdwaitaMono Nerd Font 10.5 Bold";
    padding:     0px 8px 0px 0px;
}

entry {
    text-color:        @fg;
    placeholder:        "Search applications...";
    placeholder-color:  @muted;
}

listview {
    columns:      2;
    lines:        8;
    spacing:      6px;
    fixed-height: true;
    markup-rows:  true;
}

element {
    orientation:    horizontal;
    padding:        8px 12px;
    border-radius:  8px;
    background-color: transparent;
}

element selected {
    background-color: @overlay;
    border:           1px;
    border-color:     rgba(0, 217, 255, 0.4);
}

element-icon {
    size:   24px;
    margin: 0px 10px 0px 0px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

