@import "theme.rasi"

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Launch";
    drun-display-format: "{name}";
}

window {
    width: 580px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @overlay;
    border-radius: 8px;
    padding: 10px 14px;
}

prompt {
    text-color:  @primary;
    font:        "AdwaitaMono Nerd Font 10.5 Bold";
    padding:     0px 8px 0px 0px;
}

entry {
    text-color:        @fg;
    placeholder:        "Search applications...";
    placeholder-color:  @muted;
}

listview {
    columns:      2;
    lines:        6;
    spacing:      6px;
    fixed-height: true;
}

element {
    orientation:    horizontal;
    padding:        8px 12px;
    border-radius:  8px;
    background-color: transparent;
}

element selected {
    background-color: @overlay;
    border:           1px;
    border-color:     rgba(0, 217, 255, 0.4);
}

element-icon {
    size:   24px;
    margin: 0px 10px 0px 0px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

