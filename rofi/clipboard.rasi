@import "theme.rasi"

window {
    width: 560px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: @bg;
    padding: 14px;
    children: [ inputbar, listview, message ];
}

inputbar {
    background-color: @surface;
    border-radius:    8px;
    padding:          8px 12px;
    margin:           0px 0px 10px 0px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @secondary;
    padding:    0px 8px 0px 0px;
}

entry {
    text-color:        @fg;
    placeholder:        "Clipboard...";
    placeholder-color:  @muted;
}

listview {
    columns:      1;
    lines:        12;
    spacing:      2px;
    fixed-height: false;
    background-color: transparent;
}

element {
    padding:        6px 10px;
    border-radius:  4px;
}

element-text {
    text-color: inherit;
}

message {
    background-color: @overlay;
    border-radius:    6px;
    padding:          6px 10px;
    margin:           8px 0px 0px 0px;
}

textbox {
    text-color: @muted;
    font:       "AdwaitaMono Nerd Font 12";
}
