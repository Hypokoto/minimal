@import "theme.rasi"

window {
    width: 560px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview, message ];
}

inputbar {
    children: [ prompt, entry ];
}

prompt {
    text-color: @secondary;
    padding:    0px 8px 0px 0px;
}

entry {
    text-color:        @fg;
    placeholder:        "Clipboard...";
    placeholder-color:  @muted;
}

listview {
    columns:      1;
    lines:        12;
    fixed-height: false;
}

element-text {
    text-color: inherit;
}

message {
    background-color: @overlay;
    border-radius:    8px;
    padding:          10px 12px;
    margin:           8px 0px 0px 0px;
}

textbox {
    text-color: @muted;
    font:       "AdwaitaMono Nerd Font 12";
}
