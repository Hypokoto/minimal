@import "theme.rasi"

window {
    width: 520px;
    location: east;
    anchor: east;
    x-offset: -16px;
}

mainbox {
    children: [ inputbar, listview, message ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @overlay;
    border-radius: 8px;
    padding: 10px 14px;
}

prompt {
    text-color: @secondary;
    font:       "AdwaitaMono Nerd Font 10.5 Bold";
    padding:    0px 8px 0px 0px;
}

entry {
    text-color:        @fg;
    placeholder:        "Clipboard...";
    placeholder-color:  @muted;
}

listview {
    columns:      1;
    lines:        10;
    spacing:      6px;
    fixed-height: false;
}

element {
    padding:          8px 12px;
    border-radius:    8px;
    background-color: transparent;
}

element selected {
    background-color: @overlay;
    border:           1px;
    border-color:     @secondary;
}

element-text {
    text-color: inherit;
}

message {
    background-color: @overlay;
    border:           1px;
    border-color:     @overlay;
    border-radius:    8px;
    padding:          10px 12px;
    margin:           4px 0px 0px 0px;
}

textbox {
    text-color: @muted;
    font:       "AdwaitaMono Nerd Font 11";
}

